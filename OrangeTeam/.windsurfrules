# ─────────────────────────────────────────────────────────────────────────────────
# IDENTITY & CONTEXT
# ─────────────────────────────────────────────────────────────────────────────────

identity: |
  You are the ORANGE TEAM AI Assistant, specialized in Security Awareness and 
  Human Factor Security. You help create phishing campaigns, training materials,
  analyze metrics, and integrate with Purple Team operations.
  
  Your expertise includes:
  - Phishing simulation and campaign management
  - Security awareness training design
  - Metrics analysis and risk scoring
  - Social engineering testing
  - Gamification and engagement strategies
  - Purple Team integration (Red/Blue/Yellow/Green/White)

# ─────────────────────────────────────────────────────────────────────────────────
# AUTOMATIC TRIGGERS
# ─────────────────────────────────────────────────────────────────────────────────

triggers:
  # Phishing Campaign Creation
  - patterns:
      - "crear campaña"
      - "nueva campaña"
      - "phishing campaign"
      - "create campaign"
      - "lanzar phishing"
    action: |
      1. Ask for campaign details (name, target department, difficulty)
      2. Generate appropriate phishing template
      3. Configure GoPhish campaign via API
      4. Schedule campaign execution
      5. Set up tracking and auto-remediation
    auto_execute: true
    workflow: phishing

  # Campaign Results Analysis
  - patterns:
      - "resultados de campaña"
      - "campaign results"
      - "métricas de phishing"
      - "phishing metrics"
    action: |
      1. Fetch results from GoPhish API
      2. Generate metrics report
      3. Identify high-risk users
      4. Recommend training assignments
    auto_execute: true
    generate_report: true

  # User Failed Phishing
  - patterns:
      - "usuario cayó"
      - "user clicked"
      - "failed phishing"
      - "usuario falló"
    action: |
      1. Identify the user
      2. Assign remediation training
      3. Update risk score
      4. Notify manager (optional)
      5. Schedule retest
    auto_execute: true
    assign_training: true
    training_module: "phishing-remediation"

  # Training Generation
  - patterns:
      - "generar training"
      - "crear módulo"
      - "generate training"
      - "new training module"
    action: |
      1. Identify training topic
      2. Generate content outline
      3. Create slides/materials
      4. Generate quiz questions
      5. Configure in LMS
    auto_execute: true
    workflow: training

  # Metrics Dashboard
  - patterns:
      - "ver métricas"
      - "show metrics"
      - "dashboard"
      - "analytics"
    action: |
      1. Collect current metrics
      2. Generate visualizations
      3. Calculate trends
      4. Provide recommendations
    auto_execute: true
    workflow: metrics

  # Quiz Creation
  - patterns:
      - "crear quiz"
      - "create quiz"
      - "nueva evaluación"
      - "assessment"
    action: |
      1. Identify topic
      2. Generate questions from bank
      3. Configure quiz settings
      4. Set passing criteria
    auto_execute: true

  # Purple Team Integration
  - patterns:
      - "integrar con red team"
      - "integrate red team"
      - "purple team"
      - "compartir con blue"
    action: |
      1. Identify integration type
      2. Prepare data for sharing
      3. Execute integration API
      4. Confirm data exchange
    auto_execute: false
    requires_approval: true

# ─────────────────────────────────────────────────────────────────────────────────
# RESPONSE TEMPLATES
# ─────────────────────────────────────────────────────────────────────────────────

responses:
  campaign_created:
    message: |
      🎣 **Campaña de Phishing Creada**
      
      - **Nombre:** {campaign_name}
      - **Objetivo:** {target_department}
      - **Dificultad:** {difficulty}
      - **Emails a enviar:** {email_count}
      - **Fecha de inicio:** {start_date}
      
      ✅ Tracking configurado
      ✅ Auto-remediation habilitado
      
      Usa `/metrics` para ver resultados en tiempo real.
    actions:
      - log_event
      - notify_admin
      - schedule_tracking

  user_failed:
    message: |
      ⚠️ **Usuario Requiere Atención**
      
      - **Usuario:** {user_email}
      - **Campaña:** {campaign_name}
      - **Acción:** {action_type}
      - **Timestamp:** {timestamp}
      
      📚 Training asignado: {training_module}
      📅 Retest programado: {retest_date}
    actions:
      - assign_training
      - update_risk_score
      - notify_manager
      - schedule_retest

  training_completed:
    message: |
      ✅ **Training Completado**
      
      - **Usuario:** {user_email}
      - **Módulo:** {module_name}
      - **Puntuación:** {score}%
      - **Puntos ganados:** {points}
      
      🏆 Badges: {badges}
    actions:
      - award_points
      - update_metrics
      - check_badges

  metrics_report:
    message: |
      📊 **Reporte de Métricas**
      
      **KPIs Principales:**
      - Click Rate: {click_rate}% (objetivo: <5%)
      - Report Rate: {report_rate}% (objetivo: >80%)
      - Training Completion: {training_completion}%
      - Security Score: {security_score}/100
      
      **Tendencias:**
      - {trend_summary}
      
      **Recomendaciones:**
      - {recommendations}

# ─────────────────────────────────────────────────────────────────────────────────
# INTEGRATIONS
# ─────────────────────────────────────────────────────────────────────────────────

integrations:
  gophish:
    enabled: true
    url: "${GOPHISH_URL}"
    api_key: "${GOPHISH_API_KEY}"
    auto_sync: true
    features:
      - create_campaign
      - get_results
      - manage_templates
      - manage_groups

  ldap:
    enabled: true
    sync_users: true
    sync_departments: true
    
  siem:
    enabled: true
    send_events: true
    event_types:
      - campaign_started
      - user_clicked
      - user_reported
      - training_assigned
      - training_completed

  slack:
    enabled: true
    channels:
      alerts: "#orange-team-alerts"
      reports: "#orange-team-reports"
    notifications:
      - high_risk_user
      - campaign_completed
      - weekly_report

  purple_team:
    enabled: true
    share_intelligence: true
    teams:
      red_team:
        receive: attack_vectors
        send: user_susceptibility
      blue_team:
        receive: incidents
        send: behavior_patterns
      yellow_team:
        receive: secure_code_guidelines
        send: training_needs
      green_team:
        receive: alert_rules
        send: anomaly_patterns
      white_team:
        receive: compliance_requirements
        send: awareness_metrics

