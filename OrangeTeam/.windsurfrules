# ─────────────────────────────────────────────────────────────────────────────────
# CAMPAIGN TEMPLATES
# ─────────────────────────────────────────────────────────────────────────────────

campaign_templates:
  credential_phishing:
    difficulty: medium
    templates:
      - office365_login
      - google_workspace
      - linkedin_notification
      - slack_invitation
    landing_pages:
      - fake_login
      - awareness_page
      
  malware_delivery:
    difficulty: hard
    templates:
      - invoice_attachment
      - document_review
      - software_update
    attachments:
      - tracking_document
      
  bec:
    difficulty: expert
    templates:
      - ceo_urgent_request
      - wire_transfer
      - vendor_change
    requires_approval: true
    
  awareness_test:
    difficulty: easy
    templates:
      - obvious_phishing
      - basic_credential
    purpose: baseline_assessment

# ─────────────────────────────────────────────────────────────────────────────────
# TRAINING MODULES
# ─────────────────────────────────────────────────────────────────────────────────

training_modules:
  phishing_101:
    duration: 30
    difficulty: basic
    topics:
      - identifying_phishing
      - checking_urls
      - reporting_process
    quiz_questions: 10
    passing_score: 80
    
  social_engineering:
    duration: 45
    difficulty: intermediate
    topics:
      - manipulation_techniques
      - pretexting
      - vishing
      - physical_security
    quiz_questions: 15
    passing_score: 80
    
  password_security:
    duration: 20
    difficulty: basic
    topics:
      - strong_passwords
      - password_managers
      - mfa
    quiz_questions: 8
    passing_score: 80
    
  incident_response:
    duration: 60
    difficulty: advanced
    topics:
      - recognizing_incidents
      - reporting_procedures
      - containment_basics
      - post_incident
    quiz_questions: 20
    passing_score: 85

# ─────────────────────────────────────────────────────────────────────────────────
# METRICS & THRESHOLDS
# ─────────────────────────────────────────────────────────────────────────────────

metrics:
  kpis:
    click_rate:
      target: 5
      warning: 10
      critical: 15
      unit: percent
      
    report_rate:
      target: 80
      warning: 60
      critical: 40
      unit: percent
      
    credential_submit:
      target: 2
      warning: 5
      critical: 10
      unit: percent
      
    training_completion:
      target: 95
      warning: 85
      critical: 75
      unit: percent
      
    time_to_report:
      target: 5
      warning: 15
      critical: 30
      unit: minutes
      
    repeat_offenders:
      target: 3
      warning: 5
      critical: 10
      unit: percent

  alerts:
    high_risk_user:
      condition: "click_count >= 3 in 30 days"
      action: escalate_to_manager
      
    campaign_anomaly:
      condition: "click_rate > 2x average"
      action: pause_and_review
      
    training_overdue:
      condition: "assigned > 7 days ago AND not completed"
      action: send_reminder

# ─────────────────────────────────────────────────────────────────────────────────
# SECURITY & COMPLIANCE
# ─────────────────────────────────────────────────────────────────────────────────

security:
  data_retention: 730  # days
  anonymize_reports: true
  require_consent: true
  audit_logging: true
  
compliance:
  frameworks:
    - GDPR
    - SOC2
    - ISO27001
    - NIST_CSF
  reporting:
    frequency: quarterly
    include_metrics: true
    include_trends: true

