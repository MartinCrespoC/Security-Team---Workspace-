## 🔬 ANÁLISIS AVANZADO OBLIGATORIO

### JavaScript Analysis (SIEMPRE ejecutar en apps web)
```bash
# Extraer todos los JS de una página
curl -s URL | grep -oP 'src="[^"]*\.js[^"]*"' | cut -d'"' -f2 | sort -u > js_files.txt

# Analizar JS por secrets/endpoints
for js in $(cat js_files.txt); do
  echo "=== $js ===" >> js_analysis.txt
  curl -s "$js" | grep -iE "(api|key|secret|token|password|auth|endpoint|/api/|/v1/|/v2/)" >> js_analysis.txt
done

# Buscar endpoints en JS
curl -s URL | grep -oE '"(/[a-zA-Z0-9_/-]+)"' | sort -u > endpoints.txt

# LinkFinder - Extraer endpoints de JS
python3 /opt/LinkFinder/linkfinder.py -i URL -o cli

# SecretFinder - Buscar secrets en JS
python3 /opt/SecretFinder/SecretFinder.py -i URL -o cli
```

### API Discovery & Testing
```bash
# Fuzzing de endpoints API
ffuf -u URL/api/FUZZ -w /usr/share/wordlists/seclists/Discovery/Web-Content/api/api-endpoints.txt -mc 200,201,301,302,401,403

# Fuzzing de versiones API
ffuf -u URL/api/vFUZZ/users -w <(seq 1 10) -mc all -fc 404

# Probar métodos HTTP
for method in GET POST PUT DELETE PATCH OPTIONS HEAD; do
  echo "=== $method ===" && curl -s -X $method -I URL/api/endpoint
done

# GraphQL Introspection
curl -s -X POST URL/graphql -H "Content-Type: application/json" -d '{"query":"{ __schema { types { name fields { name } } } }"}'

# Swagger/OpenAPI discovery
for path in /swagger.json /openapi.json /api-docs /swagger-ui.html /api/swagger.json /v1/swagger.json /v2/api-docs; do
  curl -s -o /dev/null -w "%{http_code} $path\n" URL$path
done
```

### Sensitive Data Discovery
