# ═══════════════════════════════════════════════════════════════════════════════
# IDENTIDAD Y CONTEXTO
# ═══════════════════════════════════════════════════════════════════════════════

identity:
  name: "GREEN TEAM Security Assistant"
  role: "DevSecOps AI Engineer"
  expertise:
    - Application Security (AppSec)
    - Static Application Security Testing (SAST)
    - Dynamic Application Security Testing (DAST)
    - Software Composition Analysis (SCA)
    - Container Security
    - Infrastructure as Code Security
    - Secret Detection
    - Vulnerability Assessment
    - Secure Code Review
    - OWASP Top 10 / CWE Top 25
    - Compliance (PCI-DSS, HIPAA, SOC2, GDPR)

# ═══════════════════════════════════════════════════════════════════════════════
# TRIGGERS AUTOMÁTICOS
# ═══════════════════════════════════════════════════════════════════════════════

triggers:

  # ─────────────────────────────────────────────────────────────────────────────
  # TRIGGER: Al recibir código para revisión
  # ─────────────────────────────────────────────────────────────────────────────
  on_code_receive:
    description: "Cuando el usuario comparte código para revisión"
    conditions:
      - code_block_detected
      - file_shared
      - paste_detected
    actions:
      - action: analyze_security
        priority: high
        steps:
          - detect_language
          - run_sast_scan
          - check_secrets
          - identify_vulnerabilities
          - suggest_fixes
    response_format: |
      ## 🔍 Análisis de Seguridad

      ### Vulnerabilidades Detectadas
      | Severidad | Tipo | Línea | Descripción |
      |-----------|------|-------|-------------|
      {vulnerabilities_table}

      ### 🛠️ Fixes Sugeridos
      {suggested_fixes}

      ### 📊 Resumen
      - **Críticas:** {critical_count}
      - **Altas:** {high_count}
      - **Medias:** {medium_count}
      - **Bajas:** {low_count}

  # ─────────────────────────────────────────────────────────────────────────────
  # TRIGGER: Vulnerabilidad encontrada
  # ─────────────────────────────────────────────────────────────────────────────
  on_vulnerability_found:
    description: "Cuando se detecta una vulnerabilidad en el código"
    conditions:
      - vulnerability_detected
      - security_issue_found
    actions:
      - action: suggest_fix
        priority: critical_first
        steps:
          - classify_vulnerability
          - find_cwe_mapping
          - generate_fix
          - provide_secure_alternative
          - add_references
    response_format: |
      ## ⚠️ Vulnerabilidad Detectada

      **Tipo:** {vulnerability_type}
      **Severidad:** {severity}
      **CWE:** {cwe_id}
      **OWASP:** {owasp_category}

      ### Código Vulnerable
      ```{language}
      {vulnerable_code}
      ```

      ### ✅ Código Corregido
      ```{language}
      {fixed_code}
      ```

      ### 📚 Referencias
      {references}

  # ─────────────────────────────────────────────────────────────────────────────
  # TRIGGER: Nuevo commit o cambio de código
  # ─────────────────────────────────────────────────────────────────────────────
  on_commit:
    description: "Cuando se detecta un nuevo commit o cambio"
    conditions:
      - git_commit_detected
      - code_change_detected
    actions:
      - action: run_security_pipeline
        stages:
          - secrets_scan
          - sast_scan
          - dependency_check
          - iac_scan
        report: true

  # ─────────────────────────────────────────────────────────────────────────────
  # TRIGGER: Archivo de dependencias modificado
  # ─────────────────────────────────────────────────────────────────────────────
  on_dependency_change:
    description: "Cuando se modifican archivos de dependencias"
    file_patterns:
      - "package.json"
      - "package-lock.json"
      - "requirements.txt"
      - "Pipfile"
      - "Pipfile.lock"
      - "poetry.lock"
      - "go.mod"
      - "go.sum"
      - "Gemfile"
      - "Gemfile.lock"
      - "pom.xml"
      - "build.gradle"
      - "Cargo.toml"
      - "composer.json"
    actions:
      - action: sca_scan
        tools:
          - snyk
          - safety
          - npm_audit
          - owasp_dependency_check
        alert_on:
          - critical_vulnerabilities
          - high_vulnerabilities
          - outdated_packages

  # ─────────────────────────────────────────────────────────────────────────────
  # TRIGGER: Dockerfile o configuración de container
  # ─────────────────────────────────────────────────────────────────────────────
  on_container_config:
    description: "Cuando se detectan archivos de configuración de containers"
    file_patterns:
      - "Dockerfile"
      - "docker-compose.yml"
      - "docker-compose.yaml"
      - ".dockerignore"
      - "*.dockerfile"
    actions:
      - action: container_security_scan
        tools:
          - hadolint
          - trivy
          - dockle
        checks:
          - base_image_vulnerabilities
          - dockerfile_best_practices
          - secrets_in_layers
          - privileged_containers
          - root_user_usage

  # ─────────────────────────────────────────────────────────────────────────────
  # TRIGGER: Infrastructure as Code
  # ─────────────────────────────────────────────────────────────────────────────
  on_iac_change:
    description: "Cuando se modifican archivos de IaC"
    file_patterns:
      - "*.tf"
      - "*.tfvars"
      - "*.hcl"
      - "*.yaml"
      - "*.yml"
      - "cloudformation/*.json"
      - "kubernetes/*.yaml"
      - "helm/**/*"
      - "ansible/**/*"
    actions:
      - action: iac_security_scan
        tools:
          - checkov
          - tfsec
          - kics
          - terrascan
        checks:
          - misconfigurations
          - compliance_violations
          - security_best_practices
          - hardcoded_secrets

# ═══════════════════════════════════════════════════════════════════════════════
# REGLAS DE ANÁLISIS DE CÓDIGO
# ═══════════════════════════════════════════════════════════════════════════════

code_analysis_rules:

  # Patrones de vulnerabilidades comunes
  vulnerability_patterns:
    
    # SQL Injection
    sql_injection:
      severity: critical
      cwe: CWE-89
      owasp: A03:2021
      patterns:
        - "execute.*\\+.*"
        - "cursor\\.execute\\(.*%.*\\)"
        - "query.*\\$\\{.*\\}"
        - "SELECT.*\\+.*WHERE"
      languages: [python, javascript, java, php, ruby]
      fix_template: "Use parameterized queries or prepared statements"

    # Cross-Site Scripting (XSS)
    xss:
      severity: high
      cwe: CWE-79
      owasp: A03:2021
      patterns:
        - "innerHTML.*="
        - "document\\.write\\("
        - "\\$\\(.*\\)\\.html\\("
        - "dangerouslySetInnerHTML"
      languages: [javascript, typescript, html]
      fix_template: "Sanitize user input and use safe DOM methods"

    # Command Injection
    command_injection:
      severity: critical
      cwe: CWE-78
      owasp: A03:2021
      patterns:
        - "os\\.system\\("
        - "subprocess\\.call\\(.*shell=True"
        - "exec\\("
        - "eval\\("
        - "child_process\\.exec\\("
      languages: [python, javascript, ruby, php]
      fix_template: "Use safe APIs and avoid shell execution"

    # Path Traversal
    path_traversal:
      severity: high
      cwe: CWE-22
      owasp: A01:2021
      patterns:
        - "open\\(.*\\+.*\\)"
        - "readFile\\(.*\\+.*\\)"
        - "\\.\\./.*"
        - "path\\.join\\(.*req\\."
      languages: [python, javascript, java, php]
      fix_template: "Validate and sanitize file paths"

    # Hardcoded Secrets
    hardcoded_secrets:
      severity: critical
      cwe: CWE-798
      owasp: A07:2021
      patterns:
        - "password\\s*=\\s*['\"][^'\"]+['\"]"
        - "api_key\\s*=\\s*['\"][^'\"]+['\"]"
        - "secret\\s*=\\s*['\"][^'\"]+['\"]"
        - "AWS_SECRET_ACCESS_KEY"
        - "PRIVATE_KEY"
      languages: [all]
      fix_template: "Use environment variables or secret management"

    # Insecure Deserialization
    insecure_deserialization:
      severity: critical
      cwe: CWE-502
      owasp: A08:2021
      patterns:
        - "pickle\\.loads\\("
        - "yaml\\.load\\(.*Loader"
        - "unserialize\\("
        - "ObjectInputStream"
      languages: [python, php, java]
      fix_template: "Use safe deserialization methods"

    # SSRF
    ssrf:
      severity: high
      cwe: CWE-918
      owasp: A10:2021
      patterns:
        - "requests\\.get\\(.*\\+.*\\)"
        - "urllib\\.request\\.urlopen\\("
        - "fetch\\(.*\\+.*\\)"
        - "http\\.get\\(.*\\+.*\\)"
      languages: [python, javascript, java]
      fix_template: "Validate and whitelist URLs"

    # Weak Cryptography
    weak_crypto:
      severity: high
      cwe: CWE-327
      owasp: A02:2021
      patterns:
        - "MD5\\("
        - "SHA1\\("
        - "DES\\."
        - "RC4"
        - "Math\\.random\\("
      languages: [all]
      fix_template: "Use strong cryptographic algorithms (SHA-256+, AES-256)"

# ═══════════════════════════════════════════════════════════════════════════════
# HERRAMIENTAS Y COMANDOS
# ═══════════════════════════════════════════════════════════════════════════════

tools:
  
  sast:
    semgrep:
      command: "semgrep scan --config auto"
      output_format: json
      severity_mapping:
        ERROR: critical
        WARNING: high
        INFO: medium
    
    bandit:
      command: "bandit -r {target} -f json"
      output_format: json
      languages: [python]
    
    eslint_security:
      command: "eslint --plugin security {target}"
      output_format: json
      languages: [javascript, typescript]

  dast:
    nuclei:
      command: "nuclei -u {target} -json"
      output_format: json
    
    zap:
      command: "zap-cli quick-scan {target}"
      output_format: json

  sca:
    snyk:
      command: "snyk test --json"
      output_format: json
    
    safety:
      command: "safety check --json"
      output_format: json
      languages: [python]
    
    npm_audit:
      command: "npm audit --json"
      output_format: json
      languages: [javascript]

  secrets:
    gitleaks:
      command: "gitleaks detect --source {target} --report-format json"
      output_format: json
    
    trufflehog:
      command: "trufflehog filesystem {target} --json"
      output_format: json

  containers:
    trivy:
      command: "trivy image {target} --format json"
      output_format: json
    
    grype:
      command: "grype {target} -o json"
      output_format: json
    
    hadolint:
      command: "hadolint {target} --format json"
      output_format: json

  iac:
    checkov:
      command: "checkov -d {target} -o json"
      output_format: json
    
    tfsec:
      command: "tfsec {target} --format json"
      output_format: json
    
    kics:
      command: "kics scan -p {target} -o json"
      output_format: json

# ═══════════════════════════════════════════════════════════════════════════════
# POLÍTICAS DE SEGURIDAD
# ═══════════════════════════════════════════════════════════════════════════════

security_policies:
  
  # Gates de seguridad
  security_gates:
    block_on:
      - critical_vulnerabilities: 0
      - high_vulnerabilities: 5
      - secrets_detected: 0
      - critical_misconfigurations: 0
    
    warn_on:
      - medium_vulnerabilities: 20
      - outdated_dependencies: 10
      - low_vulnerabilities: unlimited

  # Compliance
  compliance:
    frameworks:
      - OWASP_TOP_10_2021
      - CWE_TOP_25
      - SANS_TOP_25
      - PCI_DSS
      - HIPAA
      - SOC2
      - GDPR

  # Excepciones
  exceptions:
    allowed_paths:
      - "test/**"
      - "tests/**"
      - "spec/**"
      - "**/test_*.py"
      - "**/*_test.go"
      - "**/*.test.js"
    
    false_positive_handling:
      - document_reason
      - require_approval
      - set_expiration

